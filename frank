#!/usr/bin/env python3
import json
import os
import sys
import socket
import subprocess
from pathlib import Path

DEVICES_FILE = Path(__file__).parent / "devices.json"
CLIENT_SCRIPT = Path(__file__).parent / "client.py"
SERVER_SCRIPT = Path(__file__).parent / "server.py"
CHAT_SCRIPT = Path(__file__).parent / "chat.py"


def load_devices():
    if DEVICES_FILE.exists():
        with open(DEVICES_FILE, 'r') as f:
            return json.load(f)
    return {"devices": {}, "default_server": "", "port": 5555}


def get_my_name(config):
    hostname = socket.gethostname()
    for name, ip in config["devices"].items():
        if name.lower() in hostname.lower() or hostname.lower() in name.lower():
            return name
    return hostname


def main():
    config = load_devices()
    devices = config["devices"]
    port = config.get("port", 5555)
    default_server = config.get("default_server", "")
    
    if not devices:
        print("Error: devices.json not configured")
        sys.exit(1)
    
    my_name = get_my_name(config)
    
    if len(sys.argv) < 2:
        print(f"FrankChat Quick Launcher - You are: {my_name}")
        print("")
        print("Usage:")
        print("  frank group          - Join group chat")
        print("  frank server         - Start group chat server")
        print("  frank <device>       - P2P chat with device")
        print("")
        print("Available devices:")
        for name, ip in devices.items():
            if name != my_name:
                print(f"  - {name} ({ip})")
        sys.exit(0)
    
    command = sys.argv[1].lower()
    
    if command == "group":
        if default_server and default_server in devices:
            server_ip = devices[default_server]
            print(f"Connecting to {default_server} at {server_ip}:{port}...")
            subprocess.run([sys.executable, str(CLIENT_SCRIPT), server_ip, str(port), my_name])
            sys.exit(0)
        else:
            print("Error: No default_server set in devices.json")
            sys.exit(1)
    
    elif command == "server":
        print(f"Starting server on port {port}...")
        subprocess.run([sys.executable, str(SERVER_SCRIPT), str(port)])
        sys.exit(0)
    
    else:
        target = None
        for name, ip in devices.items():
            if name.lower() == command or name.lower().startswith(command):
                target = (name, ip)
                break
        
        if target:
            name, ip = target
            print(f"P2P chat with {name} at {ip}:{port}...")
            
            contacts_dir = Path.home() / ".frankchat"
            contacts_dir.mkdir(exist_ok=True)
            with open(contacts_dir / "contacts.json", "w") as f:
                json.dump({name: {"host": ip, "port": port}}, f)
            
            subprocess.run([sys.executable, str(CHAT_SCRIPT)])
            sys.exit(0)
        else:
            print(f"Error: Unknown device '{command}'")
            print(f"Available: {', '.join([n for n in devices.keys() if n != my_name])}")
            sys.exit(1)


if __name__ == "__main__":
    main()
